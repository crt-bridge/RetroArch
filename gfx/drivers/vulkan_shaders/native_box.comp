#version 450

// Box reduction of the core's native image: the integer sum of
// FACTOR x FACTOR texels and one truncating division, exactly as the CPU box
// does it. A linear filter is never exact, so none is used here.
// FACTOR (2, 4 or 8) is a specialisation constant: one pipeline per factor.

layout(local_size_x = 16, local_size_y = 8) in;

layout(constant_id = 0) const uint FACTOR = 4u;

layout(set = 0, binding = 0, std140) uniform UBO
{
	uvec2 out_size;
};

layout(set = 0, binding = 1) uniform sampler2D uSrc;

layout(set = 0, binding = 4, std430) writeonly buffer SSBO
{
	uint packed_pixels[];
};

void main()
{
	uvec2 o = gl_GlobalInvocationID.xy;
	if (any(greaterThanEqual(o, out_size)))
		return;

	uvec3 sum = uvec3(0u);
	for (uint y = 0u; y < FACTOR; y++)
		for (uint x = 0u; x < FACTOR; x++)
			sum += uvec3(texelFetch(uSrc, ivec2(o * FACTOR + uvec2(x, y)), 0).rgb * 255.0 + 0.5);

	sum /= (FACTOR * FACTOR);
	packed_pixels[o.y * out_size.x + o.x] = sum.r | (sum.g << 8) | (sum.b << 16) | 0xff000000u;
}
